# ==============================================================================
# Variables d'Environnement - Déploiement Google Cloud Platform (Cloud Run)
# ==============================================================================

# Port standard Cloud Run (injecté automatiquement par Cloud Run si omis)
PORT=8080
NODE_ENV=production

# Chaîne de connexion Firestore (Édition Enterprise avec compatibilité MongoDB SCRAM-SHA-256)
# Remplacez <username> et <password> par vos identifiants Firestore :
MONGODB_URI="mongodb://<username>:<password>@375ae89d-c05f-41d3-b6fa-0defb1254e90.europe-west9.firestore.goog:443/clean-blog-db?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false"

# Clé secrète de session Express (minimum 32 caractères aléatoires)
SESSION_SECRET=generate_with_node_crypto_randomBytes_32_hex

# Google reCAPTCHA v2 / v3
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Envoi d'emails (SendGrid ou SMTP)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
CONTACT_EMAIL=contact@votredomaine.com

# Sécurité & Trafic
CORS_ORIGIN=https://clean-blog-xxxxxx-ew.a.run.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
